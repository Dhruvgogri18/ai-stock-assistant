# =============================================================================
# Stock Research — environment example
# Copy to ".env" in the repo root and fill in values. Never commit .env.
# =============================================================================

# ---- Product ----
APP_NAME=Stock Research
USER_NAME=

# ---- LLM (OpenAI-compatible gateway) ----
LLM_API_KEY=
LLM_BASE_URL=https://aigateway-api.godigitaltc.com/aigw/v1
LLM_MODEL=
# Leave the three LLM_* values blank on a public deployment - the app then uses the free fallbacks below.

# ---- Free fallback LLMs (used when the gateway is blank/unreachable) ----
# 1) Google Gemini - free key: https://aistudio.google.com/apikey
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_LLM_MODEL=gemini-2.5-flash
# 2) Groq - free key: https://console.groq.com/keys
FALLBACK2_LLM_API_KEY=
FALLBACK2_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK2_LLM_MODEL=llama-3.3-70b-versatile
FALLBACK2_LLM_FAST_MODEL=llama-3.1-8b-instant
# Optional cheaper/faster model for the router (falls back to LLM_MODEL)
LLM_FAST_MODEL=
LLM_TIMEOUT=90
LLM_MAX_TOKENS=2000
MAX_TOOL_ROUNDS=4
ROUTER_ENABLED=true

# ---- LLM logging ----
LLM_LOG=true
LLM_LOG_DIR=logs
LLM_LOG_PROMPTS=true
LLM_LOG_MAX_CONTENT=50000
LLM_PRICING_MODEL=

# ---- Storage ----
# Warehouse (fundamentals, ratios, filings). SQLite path OR Postgres URL.
DB_PATH=stock.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/stock
# Sessions / messages / watchlist (SQLite, separate from warehouse)
SESSION_DB_PATH=data/sessions.db

# ---- Data provider ----
# auto | db | indianapi | yfinance
# auto = prefer DB if populated, else IndianAPI if key set, else yfinance
DATA_PROVIDER=auto

# IndianAPI (optional; quota-limited)
INDIANAPI_KEY=
INDIANAPI_BASE=https://stock.indianapi.in

# ---- NSE bhavcopy (EOD technical data) ----
BHAVCOPY_AUTO_REFRESH=true
BHAVCOPY_PUBLISH_AFTER_IST=18:30
BHAVCOPY_CHECK_INTERVAL_MIN=30
BHAVCOPY_STARTUP_BACKFILL_DAYS=30
MOVERS_MIN_TURNOVER_CR=1.0

# ---- Angel One SmartAPI (live LTP, candles, indices) ----
# https://smartapi.angelbroking.com/ — free with an Angel One account
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
# Base32 secret from SmartAPI TOTP setup (required for login)
ANGEL_TOTP_SECRET=
# Optional; usually filled at runtime after login
ANGEL_FEED_TOKEN=
ANGEL_JWT=

# ---- Announcements loader (BSE → filings / RAG) ----
ANNOUNCEMENTS_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,WIPRO,HCLTECH,SBIN,ITC,BHARTIARTL

# ---- Optional embeddings for RAG ----
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ---- Web ----
# Comma-separated origins, or * for all
CORS_ALLOW_ORIGINS=*