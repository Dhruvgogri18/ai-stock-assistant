# Copy to .env and fill in what you need:
#   cp .env.example .env

# =============================================================================
# LLM (leave empty until you have a key — app starts without them)
# Any OpenAI-compatible endpoint works (xAI Grok, your gateway, OpenRouter, etc.)
# =============================================================================
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_FAST_MODEL=
LLM_TIMEOUT=90
LLM_MAX_TOKENS=2000

# =============================================================================
# Market data (optional for a minimal demo)
# =============================================================================
# IndianAPI — fundamentals / news when not in local DB
INDIANAPI_KEY=

# Data source preference: auto | db | indianapi | yfinance
DATA_PROVIDER=auto

# =============================================================================
# Storage
# =============================================================================
# Local SQLite warehouse (default). On deploy, prefer DB_DOWNLOAD_URL (see DEPLOY.md).
DB_PATH=stock.db
SESSION_DB_PATH=data/sessions.db

# Optional: use free Postgres instead of SQLite (Neon / Supabase).
# If set, warehouse uses Postgres and DB_PATH is ignored.
# DATABASE_URL=postgresql://user:pass@host/dbname

# On cloud hosts: URL of a pre-built stock.db or stock.db.gz (GitHub Release asset).
# DB_DOWNLOAD_URL=

# =============================================================================
# Angel One (optional — live quotes)
# =============================================================================
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# =============================================================================
# App
# =============================================================================
APP_NAME=Stock Research
CORS_ALLOW_ORIGINS=*
BHAVCOPY_AUTO_REFRESH=true
PRICES_LIVE=true